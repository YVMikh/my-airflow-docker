# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_pg_password
POSTGRES_DB=airflow

# Airflow Core & Security
AIRFLOW__CORE__FERNET_KEY=generate_with_python_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=generate_with_python_secrets
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=False
AIRFLOW__CORE__TEST_CONNECTION=Disabled

# Airflow Admin UI
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me_admin_password

# Superset
SUPERSET_SECRET_KEY=generate_with_python_secrets